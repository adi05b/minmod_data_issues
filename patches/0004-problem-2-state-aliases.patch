From 102da1cc055f21480c63ce8a61d807881b2e5769 Mon Sep 17 00:00:00 2001
From: Aditi Bombe <196845785+adi05b@users.noreply.github.com>
Date: Thu, 8 Oct 2026 00:58:06 +0000
Subject: [PATCH] Resolve state aliases from an "alt names" column at merge
 time

The repair drops a state when the record's own name matches nothing in the
recorded country. Many of those names are the same place under another
name (Orissa for Odisha, Niedersachsen for Lower Saxony). This reads an
optional "alt names" column from state_or_province.csv, pipe-separated like
country.csv's, and lets the repair match on it.

Aliases are a fourth, last tier: exact folded name only, reached only when
the real-name, admin-word-free and state-code tiers all find nothing. Real
names and codes always win, so an alias can turn a drop into a repoint but
can never change or block a match made without it. Two states of one
country sharing an alias stay ambiguous and resolve to nothing.

They are used for matching only. The entity step writes them into
state_or_province.json, which the ETL merge reads through
FileEntityService; StateOrProvince.from_dict ignores the key, so Postgres
and the KG never see them and no migration is needed. The Postgres-backed
EntityService (API saves, GeoChem loader) has no aliases and behaves as
before. Without the column, or with it empty, the entity JSON and every
resolution are byte-for-byte what they were.

Tests cover an alias resolving, a real name beating an alias, a shared
alias, the empty and absent column, and, on all 5,084 states, that aliases
cannot alter any existing match. Two data checks fail if an alias in the
CSV equals a real name in its country or does not resolve to its own
state; point MINMOD_ENTITY_DIR at a ta2-minmod-data checkout to run them
on the real table.
---
 minmodkg/etl/kgrel_entity.py      |  25 ++-
 minmodkg/misc/state_repair.py     |  33 +++-
 minmodkg/services/kgrel_entity.py |  18 +-
 tests/misc/test_state_repair.py   | 263 ++++++++++++++++++++++++++++++
 4 files changed, 331 insertions(+), 8 deletions(-)
 create mode 100644 tests/misc/test_state_repair.py

diff --git a/minmodkg/etl/kgrel_entity.py b/minmodkg/etl/kgrel_entity.py
index 910e18e..615e8a9 100644
--- a/minmodkg/etl/kgrel_entity.py
+++ b/minmodkg/etl/kgrel_entity.py
@@ -106,9 +106,18 @@ class EntityDeserFn:
     def invoke(self, infile: InputFile, outdir: Path) -> list[Path]:
         records = self.read_file(infile.path)
         clsname = records[0].__class__.__name__
+        dicts = [r.to_dict() for r in records]
+        if infile.path.name == "state_or_province.csv":
+            # aliases ride along in the JSON for the merge-time state repair
+            # only; StateOrProvince.from_dict ignores them, so they never reach
+            # Postgres, and to_kg() leaves them out of the KG
+            aliases = self.read_state_or_province_aliases(infile.path)
+            for d in dicts:
+                if d["id"] in aliases:
+                    d["aliases"] = aliases[d["id"]]
 
         serde.json.ser(
-            {clsname: [r.to_dict() for r in records]},
+            {clsname: dicts},
             outdir / f"{infile.path.stem}.json",
             indent=2,
         )
@@ -278,6 +287,20 @@ class EntityDeserFn:
             )
         return records
 
+    @staticmethod
+    def read_state_or_province_aliases(infile: Path) -> dict[str, list[str]]:
+        """The optional `alt names` column: other names sources use for a state
+        ("Orissa" for Odisha), pipe-separated like country.csv's. Empty or absent
+        for most rows; only the merge-time state repair uses them."""
+        raw_records = serde.csv.deser(infile, deser_as_record=True)
+        aliases = {}
+        for raw_record in raw_records:
+            names = [s.strip() for s in (raw_record.get("alt names") or "").split("|")]
+            names = [s for s in names if s != ""]
+            if len(names) > 0:
+                aliases[raw_record["minmod_id"]] = names
+        return aliases
+
     @staticmethod
     def read_unit(infile: Path) -> list[Unit]:
         raw_records = serde.csv.deser(infile, deser_as_record=True)
